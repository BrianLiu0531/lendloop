# Next.js app (.env.local, git-ignored). `npx convex dev` writes the CONVEX_* lines for you.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Convex deployment env vars are NOT read from this file. Set them with:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#   npx convex env set ADMIN_EMAILS you@example.com
#   npx convex env set APP_URL http://localhost:3000
#   npx convex env set N8N_LOAN_EVENTS_WEBHOOK_URL http://localhost:5678/webhook/lendloop-loan-events
#   npx convex env set N8N_OUTBOUND_SIGNING_SECRET <same as LENDLOOP_OUTBOUND_SIGNING_SECRET>
#   npx convex env set N8N_INBOUND_SIGNING_SECRET  <same as LENDLOOP_INBOUND_SIGNING_SECRET>
# (or run: npm run setup:secrets, which generates and sets both signing secrets)
