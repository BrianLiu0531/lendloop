# Copy to n8n/.env (git-ignored). Generate secrets with:  openssl rand -hex 32
# Never commit real values; workflows read these via $env at runtime.

# n8n itself
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=
TIMEZONE=UTC
# Public base URL n8n advertises for webhooks (a tunnel URL when Convex runs in the cloud).
N8N_PUBLIC_URL=http://localhost:5678/

# Convex HTTP actions base URL as seen FROM the n8n container.
#   Convex local backend:  http://host.docker.internal:3211
#   Convex cloud:          https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211

# Must equal N8N_OUTBOUND_SIGNING_SECRET in Convex (Convex signs, n8n verifies).
LENDLOOP_OUTBOUND_SIGNING_SECRET=
# Must equal N8N_INBOUND_SIGNING_SECRET in Convex (n8n signs, Convex verifies).
LENDLOOP_INBOUND_SIGNING_SECRET=

LENDLOOP_MAIL_FROM=LendLoop <hello@lendloop.test>
LENDLOOP_OPS_EMAIL=ops@lendloop.test

# SMTP used to create the n8n credential at setup time. Defaults point at Mailpit.
LENDLOOP_SMTP_HOST=mailpit
LENDLOOP_SMTP_PORT=1025
LENDLOOP_SMTP_USER=
LENDLOOP_SMTP_PASSWORD=

# Only on networks that intercept TLS (antivirus HTTPS scanning, corporate proxy):
# export that root CA as PEM to n8n/certs/extra-ca.pem, then uncomment.
# LENDLOOP_EXTRA_CA_CERT=/extra-certs/extra-ca.pem
