{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit && tsc -p convex --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "setup:secrets": "node scripts/setup-secrets.mjs",
    "seed": "convex run seed:run",
    "n8n:up": "docker compose -f n8n/docker-compose.yml --env-file n8n/.env up -d",
    "n8n:down": "docker compose -f n8n/docker-compose.yml --env-file n8n/.env down",
    "n8n:setup": "node scripts/n8n-setup.mjs",
    "n8n:export": "node scripts/n8n-setup.mjs --export"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@convex-dev/rate-limiter": "^0.4.3",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.134",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.67",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
